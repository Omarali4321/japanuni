// This schema is the introspection target for the existing JapanUni database.
// Run `npm run db:pull` only after setting a local Railway DATABASE_URL.
// Do not run `prisma migrate` or `prisma db push` against the existing database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
