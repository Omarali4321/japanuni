// User data schema for Neon PostgreSQL.
// Reference data (universities, cities, scholarships, guides) moved to JSON files in data/.
// Run `prisma migrate deploy` or `prisma db push` to apply to Neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  email      String   @unique @db.VarChar(100)
  password   String
  fullName   String   @map("full_name") @db.VarChar(100)
  bio        String?  @db.VarChar(500)
  nationality String? @db.VarChar(100)
  avatarUrl  String?  @map("avatar_url") @db.VarChar(200)
  role       Role     @default(USER)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  favorites Favorite[]
  reviews   Review[]

  @@map("users")
}

model Favorite {
  id           BigInt     @id @default(autoincrement()) @db.BigInt
  userId       BigInt     @map("user_id") @db.BigInt
  universityId BigInt     @map("university_id") @db.BigInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, universityId])
  @@map("favorites")
}

model Review {
  id           BigInt     @id @default(autoincrement()) @db.BigInt
  rating       Int
  comment      String?
  userId       BigInt     @map("user_id") @db.BigInt
  universityId BigInt     @map("university_id") @db.BigInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model ContactMessage {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(100)
  subject   String   @db.VarChar(50)
  message   String   @db.VarChar(5000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contact_messages")
}
