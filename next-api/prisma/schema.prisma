// Manual schema equivalent for the current Spring/JPA domain model.
// This targets the new, currently empty Neon database.
// Do not run `prisma migrate` or `prisma db push` in this preparation phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  email      String   @unique @db.VarChar(100)
  password   String
  fullName   String   @map("full_name") @db.VarChar(100)
  bio        String?  @db.VarChar(500)
  nationality String? @db.VarChar(100)
  avatarUrl  String?  @map("avatar_url") @db.VarChar(200)
  role       Role     @default(USER)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  favorites Favorite[]
  reviews   Review[]

  @@map("users")
}

model City {
  id                   BigInt       @id @default(autoincrement()) @db.BigInt
  name                 String       @unique @db.VarChar(100)
  description          String?      @db.VarChar(1000)
  costOfLivingMonthly  Int?         @map("cost_of_living_monthly")
  imageUrl             String?      @map("image_url") @db.VarChar(500)

  universities University[]

  @@map("cities")
}

model University {
  id                 BigInt   @id @default(autoincrement()) @db.BigInt
  name               String   @db.VarChar(200)
  description        String?
  ranking            Int?
  tuitionFeeYearly   Decimal? @map("tuition_fee_yearly") @db.Decimal(38, 2)
  ieltsRequirement   Float?   @map("ielts_requirement")
  toeflRequirement   Int?     @map("toefl_requirement")
  jlptRequirement    String?  @map("jlpt_requirement")
  acceptanceRate     Float?   @map("acceptance_rate")
  programs           String?
  dormitoryInfo      String?  @map("dormitory_info")
  websiteUrl         String?  @map("website_url") @db.VarChar(500)
  sourceDataset      String?  @map("source_dataset") @db.VarChar(100)
  sourceKey          String?  @unique @map("source_key") @db.VarChar(255)
  sourceUrl          String?  @map("source_url") @db.VarChar(1000)
  sourceRowHash      String?  @map("source_row_hash") @db.VarChar(64)
  sourceRowCount     Int?     @map("source_row_count")
  institutionType    String?  @map("institution_type") @db.VarChar(100)
  faculty            String?
  degree             String?  @db.VarChar(500)
  intake             String?  @db.VarChar(200)
  mediumOfInstruction String? @map("medium_of_instruction") @db.VarChar(500)
  preArrivalAdmission String? @map("pre_arrival_admission") @db.VarChar(500)
  majorSpeciality    String?  @map("major_speciality")
  cityId             BigInt?  @map("city_id") @db.BigInt

  city       City?           @relation(fields: [cityId], references: [id])
  images     UniversityImage[]
  scholarships Scholarship[]
  favorites  Favorite[]
  reviews    Review[]

  @@map("universities")
}

model UniversityImage {
  universityId BigInt     @map("university_id") @db.BigInt
  imageUrl     String     @map("image_url")
  university   University @relation(fields: [universityId], references: [id])

  @@id([universityId, imageUrl])
  @@map("university_images")
}

model Scholarship {
  id           BigInt      @id @default(autoincrement()) @db.BigInt
  title        String      @db.VarChar(200)
  description  String?
  amountYearly Decimal?    @map("amount_yearly") @db.Decimal(38, 2)
  coverage     String?     @db.VarChar(50)
  deadlineMonth String?    @map("deadline_month")
  eligibility  String?
  universityId BigInt?     @map("university_id") @db.BigInt

  university University? @relation(fields: [universityId], references: [id])

  @@map("scholarships")
}

model Favorite {
  id           BigInt     @id @default(autoincrement()) @db.BigInt
  userId       BigInt     @map("user_id") @db.BigInt
  universityId BigInt     @map("university_id") @db.BigInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id])
  university University @relation(fields: [universityId], references: [id])

  @@unique([userId, universityId])
  @@map("favorites")
}

model Review {
  id           BigInt     @id @default(autoincrement()) @db.BigInt
  rating       Int
  comment      String?
  userId       BigInt     @map("user_id") @db.BigInt
  universityId BigInt     @map("university_id") @db.BigInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id])
  university University @relation(fields: [universityId], references: [id])

  @@map("reviews")
}

model AdmissionGuide {
  id        BigInt  @id @default(autoincrement()) @db.BigInt
  title     String  @db.VarChar(200)
  content   String
  category  String? @db.VarChar(50)
  sortOrder Int     @default(0) @map("sort_order")

  @@map("admission_guides")
}

model VisaGuide {
  id        BigInt  @id @default(autoincrement()) @db.BigInt
  title     String  @db.VarChar(200)
  content   String
  visaType  String? @map("visa_type") @db.VarChar(50)
  sortOrder Int     @default(0) @map("sort_order")

  @@map("visa_guides")
}

model StudentLifeArticle {
  id        BigInt  @id @default(autoincrement()) @db.BigInt
  title     String  @db.VarChar(200)
  content   String
  category  String? @db.VarChar(50)
  imageUrl  String? @map("image_url") @db.VarChar(500)
  sortOrder Int     @default(0) @map("sort_order")

  @@map("student_life_articles")
}
