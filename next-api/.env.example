# Required for Prisma introspection. Copy the pooled connection string from the
# Neon dashboard and set it locally; never commit the real value.
# Neon pooled hostnames commonly contain "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@EP-EXAMPLE-POOLER.REGION.aws.neon.tech/NEON_DATABASE?sslmode=require

# Optional direct Neon connection for future schema administration.
# Leave unset for this read-only preparation phase. Never use it for app traffic.
# DIRECT_URL=postgresql://USER:PASSWORD@EP-EXAMPLE.REGION.aws.neon.tech/NEON_DATABASE?sslmode=require

# Required for signed httpOnly auth cookies.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
